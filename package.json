{
  "name": "dbde",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run --maxWorkers=2",
    "format": "prettier --write src vite.config.ts tsconfig.json package.json index.html src-tauri/tauri.conf.json src-tauri/capabilities/default.json README.md",
    "format:check": "prettier --check src vite.config.ts tsconfig.json package.json index.html src-tauri/tauri.conf.json src-tauri/capabilities/default.json README.md",
    "release:build": "node scripts/release-build.mjs",
    "updater:manifest": "node scripts/update-manifest.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.12",
    "@tauri-apps/api": "^2.8.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql-formatter": "^15.6.0",
    "sql.js": "^1.13.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.2",
    "vite": "^6.3.6",
    "vitest": "^4.1.11"
  }
}

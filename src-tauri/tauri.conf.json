{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DBde",
  "version": "0.2.0",
  "identifier": "com.dbde.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DBde \u2014 Database Desktop",
        "width": 1280,
        "height": 850,
        "minWidth": 820,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDNTFERDg1NTNFQkI0ODAKUldTQXRPdFRoZDFSTExBdjhoSFBIQjFjcDlUZHRiamVDNlFoZm5kdnBjQ0ZJRU0xS3dJZER5bEoK",
      "endpoints": [
        "https://github.com/adeJN/dbde/releases/latest/download/latest.json"
      ]
    }
  }
}
